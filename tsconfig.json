{
	"include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
	"files": [],
	"references": [
		{
			"path": "./tsconfig.node.json"
		},
		{
			"path": "./tsconfig.app.json"
		}
	],
	"compilerOptions": {
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"jsx": "preserve",
    	"jsxImportSource": "vue",
	    "paths": {
	      "@/*": ["./src/*"]
	    }
	}
}
